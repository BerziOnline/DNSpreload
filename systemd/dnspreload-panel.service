[Unit]
Description=dnspreload v2: web panel (address/port: PANEL_BIND/PANEL_PORT in config.env)
After=network-online.target unbound.service

[Service]
NoNewPrivileges=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/dnspreload-v2/lists /opt/dnspreload-v2/state /opt/dnspreload-v2/logs
User=dnspreload
WorkingDirectory=/opt/dnspreload-v2
ExecStart=/opt/dnspreload-v2/panel panel
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
