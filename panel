        if rv.get("device_note"): why += f"<li>{html.escape(rv['device_note'])}</li>"
        why += "".join(f"<li class=obs>{html.escape(w)}</li>" for w in x["why"])
        if x.get("devices"): why += f"<li class=obs>{_('Devices: ')}{html.escape(device_list(x['devices']))}</li>"
        meta = _('{devices} devices · {queries} queries').format(devices=x.get('clients', 0), queries=x.get('queries', 0)) + (_(' · Lists {lists}').format(lists=x['lists']) if x.get("lists") else "")
        b = (("allow", _('Allow'), "ok"), ("dismiss", _('Dismiss'), ""), ("later", _('Later'), "")) if x["kind"] == "over" else (("deny", _('Block'), "warn"), ("dismiss", _('Dismiss'), ""), ("later", _('Later'), ""))
        btns = "".join(f"<button name=d value={v} class='{c}'>{t}</button>" for v, t, c in b)
        return (f"<div class=cand><div class=dom><b>{html.escape(x['domain'])}</b><span>{meta}{_(' · Score {score}').format(score=x['score'])}</span></div><ul>{why}</ul>"
                f"<form method=post action=/blocking><input type=hidden name=domain value='{html.escape(x['domain'])}'>{btns}</form></div>")
    over, under = d.get("over", []), d.get("under", [])
    ts = time.strftime("%d.%m. %H:%M", time.localtime(d["time"])) if d.get("time") else _('not yet')
    rts = (time.strftime("%d.%m. %H:%M", time.localtime(d["reviewed_at"])) if d.get("reviewed_at") else _('not yet')) + _(' · {pending} awaiting review · {dropped} dropped').format(pending=d.get('pending', 0), dropped=d.get('dropped', 0))
    recent = sorted(dec.items(), key=lambda kv: -kv[1].get("ts", 0))[:15]
    hist = "".join(f"<li>{time.strftime('%d.%m.', time.localtime(v.get('ts', 0)))} <b>{html.escape(k)}</b> → {dict(allow=_('allowed'), deny=_('blocked'), dismiss=_('dismissed'), later=_('later')).get(v['decision'], v['decision'])}</li>" for k, v in recent) or f"<li>{_('none yet')}</li>"
    css = CSS + ".cand{background:#161b22;border:1px solid #30363d;border-radius:10px;padding:12px;margin:8px 0}.cand .dom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px}.cand .dom span{color:#8b949e;font-size:13px}.cand ul{margin:8px 0;padding-left:18px;color:#c9d1d9;font-size:14px}.cand form{display:flex;gap:8px}.cand button{flex:1;padding:10px;border-radius:8px;border:1px solid #30363d;background:#21262d;color:#e6edf3;font-size:15px}.cand button.ok{background:#1f6f3f}.cand button.warn{background:#7a2e2e}.cand button{white-space:nowrap;padding:10px 4px;font-size:14px}.cand li.obs{color:#8b949e}.empty{color:#8b949e;padding:12px}"
    return (f"<!doctype html><html lang={UI_LANG}><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>{_('Blocking suggestions')}</title><style>{css}</style></head>"
            f"<body><header><h1><img src=/logo.svg alt='' style='height:26px;vertical-align:-6px;margin-right:8px'>{_('Blocking suggestions')}</h1><span>{_('Candidates {ts} · Review {rts} · ').format(ts=ts, rts=rts)}<a href=/ style='color:#58a6ff'>{_('back')}</a></span></header><main>"
            f"<section><h2>{_('Likely overblocked ({n})').format(n=len(over))}</h2><p class=empty>{_('Domains that worked before the last list update, are retried in bursts by apps, or belong to the site you are visiting. “Allow” adds them to the Pi-hole allowlist.')}</p>{''.join(card(x) for x in over) or '<p class=empty>' + _('none — all good.') + '</p>'}</section>"
            f"<section><h2>{_('Likely underblocked ({n})').format(n=len(under))}</h2><p class=empty>{_('Allowed queries listed in Hagezi ULTIMATE or with tracking patterns in their names. “Block” adds them to the Pi-hole denylist.')}</p>{''.join(card(x) for x in under) or '<p class=empty>' + _('none.') + '</p>'}</section>"
            f"<section><h2>{_('Recent decisions')}</h2><ul style='padding-left:18px;font-size:14px'>{hist}</ul></section>"
            f"</main><footer>{_('Calculated every 6 h without AI. Dismiss pauses for 90 days; Later for 14 days.')}</footer></body></html>")

class H(BaseHTTPRequestHandler):
    def auth(self):
        """Return (role, label) from admin networks or header/cookie tokens; None denies access."""
        ip = self.client_address[0]
        tok = None
        a = self.headers.get("Authorization", "")
        if a.startswith("Bearer "): tok = a[7:].strip()
        if not tok:
            c = http.cookies.SimpleCookie(self.headers.get("Cookie", "")); tok = c["dnsp"].value if "dnsp" in c else None
        if tok: return role_of(tok)            # A supplied token alone determines the role; invalid tokens deny access.
        # Token-free admin access is browser-only; the API always requires a token.
        if not self.path.startswith("/api/") and ip.startswith(ADMIN_NETS): return ("admin", ip)
        return None
    def out(self, code, body, ct="text/html; charset=utf-8", extra=()):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code); self.send_header("Content-Type", ct); self.send_header("Content-Length", str(len(b))); self.send_header("Cache-Control", "no-store")
        for k, v in extra: self.send_header(k, v)
        self.end_headers(); self.wfile.write(b)
    def js(self, code, obj): self.out(code, json.dumps(obj, default=str), "application/json")
    def visible(self, role): return [sw for sw in switches() if role in sw.get("roles", ["admin"])]

    def log_message(self, *a): pass
    def do_GET(self):
        try:
            m = re.fullmatch(r"/u/([A-Za-z0-9]{16,64})", self.path)
            if m:  # Store the entry-link token as a cookie, then remove it from the URL.
                if not role_of(m.group(1)): self.out(403, _('Invalid link.')); return
                self.out(303, "", extra=(("Location", "/u"), ("Set-Cookie", f"dnsp={m.group(1)}; Path=/; Max-Age=31536000; HttpOnly; SameSite=Lax"))); return
            who = self.auth()
            if not who: self.js(401, {"error": _('access denied')}) if self.path.startswith("/api/") else self.out(401, _('Access denied. Use the link from your admin.')); return
            role, label = who
            if self.path == "/u": self.out(200, family_page(self.visible(role), label)); return
            if self.path == "/api/v1/switches": self.js(200, {"role": role, "switches": self.visible(role)}); return
            if role != "admin": self.out(403, _('Admins only.')); return
            if self.path == "/api/v1/status":
                d = snapshot(); self.js(200, {k: d[k] for k in ("time", "unbound_up", "dig_ok", "dig_ms", "ftl_active", "cache", "rrset", "failed", "timers", "uptime_h")}); return
            if self.path == "/api/v1/stats":
                d = snapshot(); self.js(200, {"pihole": d["pihole"], "unbound": {k: d[k] for k in ("queries", "hits", "prefetch", "expired", "servfail", "recursion_avg_ms")}, "lists": d["lists"], "last_run": d["last_run"], "history": d["history"]}); return
            if self.path == "/json": self.js(200, snapshot()); return
            if self.path == "/metrics":
                p = STATE / "metrics.txt"; self.out(200, p.read_text() if p.exists() else "", "text/plain"); return
            if self.path == "/": self.out(200, page(snapshot())); return
            if self.path == "/blocking": self.out(200, blocking_page()); return
            if self.path == "/api/v1/daystats":
                p = STATE / "daystats.json"; self.out(200, p.read_text() if p.exists() else "{}", "application/json"); return
            if self.path in ("/logo.svg", "/favicon.ico"):
                lp = Path("/opt/dnspreload-v2/brand/dnspreload-logo.svg")
                if lp.exists(): self.out(200, lp.read_text(), "image/svg+xml"); return
                self.out(404, "", "text/plain"); return
            if self.path == "/api/v1/tokens":
                if role != "admin": self.js(403, {"error": _('admin only')}); return
                self.js(200, {"tokens": token_list()}); return
            if self.path == "/api/v1/blocking": self.js(200, reviewed_blocking()); return
            if self.path == "/api/v1/blocking/raw":
                p = STATE / "blockmon.json"; self.out(200, p.read_text() if p.exists() else "{}", "application/json"); return
            self.send_error(404)
        except Exception as e: self.send_error(500, str(e))
    def do_POST(self):
        who = self.auth()
        if not who: self.js(401, {"error": _('access denied')}); return
        role, label = who
        raw = self.rfile.read(int(self.headers.get("Content-Length", 0))).decode()
        if self.path == "/api/v1/tokens":
            if role != "admin": self.js(403, {"error": _('admin only')}); return
            try: body = json.loads(raw or "{}"); tok = token_add(body["role"], body["label"])
            except Exception: tok = None
            if tok: self.js(200, {"ok": True, "token": tok, "tokens": token_list()})
            else: self.js(400, {"ok": False, "error": _('Role admin|family, label 1-40 characters')})
            return
        m = re.fullmatch(r"/api/v1/tokens/(\d+)/revoke", self.path)
        if m:
            if role != "admin": self.js(403, {"error": _('admin only')}); return
            # Do not revoke the last admin token.
            tl = token_list(); victim = next((t for t in tl if t["id"] == m.group(1)), None)
            if victim and victim["role"] == "admin" and len([t for t in tl if t["role"] == "admin"]) <= 1: self.js(400, {"ok": False, "error": _('last admin token')}); return
            ok = token_revoke(m.group(1)); self.js(200 if ok else 400, {"ok": ok, "tokens": token_list()}); return
        if self.path == "/api/v1/blocking/review":
            if role != "admin": self.js(403, {"error": _('admin only')}); return
            try: body = json.loads(raw or "{}"); rv = body["reviews"]; assert isinstance(rv, dict) and len(raw) < 2_000_000
            except Exception: self.js(400, {"error": _('reviews missing')}); return
            p = STATE / "blockmon-review.json"; tmp = p.with_suffix(".tmp"); tmp.write_text(json.dumps({"reviews": rv, "time": time.time()}, ensure_ascii=False)); os.replace(tmp, p)
            self.js(200, {"ok": True, "n": len(rv)}); return
        if self.path in ("/blocking", "/api/v1/blocking"):
            if role != "admin": self.js(403, {"error": _('admin only')}); return
            body = json.loads(raw or "{}") if self.path.startswith("/api/") else {k: v[0] for k, v in urllib.parse.parse_qs(raw).items()}
            d, dom = body.get("d") or body.get("decision"), (body.get("domain") or "").lower()
            ok = d in ("allow", "deny", "dismiss", "later") and re.fullmatch(r"[a-z0-9]([a-z0-9-]{0,62}\.)+[a-z]{2,24}", dom) is not None
            if ok: ok = subprocess.run(["sudo", "-n", "/usr/local/bin/dnspreload-blockmon", "apply", d, dom, "panel"], capture_output=True, timeout=30).returncode == 0
            if self.path.startswith("/api/"): self.js(200 if ok else 400, {"ok": ok}); return
            if not ok: self.out(400, _('Invalid input.')); return
            self.out(303, "", extra=(("Location", "/blocking"),)); return
        m = re.fullmatch(r"/(?:u/)?switch/([a-z][a-z0-9-]{1,30})", self.path) or re.fullmatch(r"/api/v1/switch/([a-z][a-z0-9-]{1,30})", self.path)
        if not m: self.send_error(404); return
        name = m.group(1)
        if name not in [sw["name"] for sw in self.visible(role)]: self.js(403, {"error": _('not available')}); return
        if self.path.startswith("/api/"):
            try: body = json.loads(raw or "{}")
            except ValueError: self.js(400, {"error": "json"}); return
            ok = switch_set(name, body.get("action"), body.get("minutes"))
            self.js(200 if ok else 400, {"ok": ok, "switch": next((sw for sw in switches() if sw["name"] == name), None)}); return
        a = urllib.parse.parse_qs(raw).get("a", [""])[0]; mm = re.fullmatch(r"on(\d{1,3})", a)
        if a == "off": switch_set(name, "off")
        elif mm: switch_set(name, "on", int(mm.group(1)))
        self.out(303, "", extra=(("Location", "/u" if self.path.startswith("/u/") or role != "admin" else "/"),))

