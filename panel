# ---------- Data ----------
def sh(*cmd, timeout=15):
    try: return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception: return ""

def ustats():
    out = sh("sudo", "-n", "unbound-control", "stats_noreset")
    try: return {k: float(v) for k, v in (l.split("=", 1) for l in out.splitlines() if "=" in l)}
    except Exception: return {}

def pihole_today():
    """Queries, blocked queries and clients since midnight. None means unreadable, never healthy."""
    try:
        t0 = time.mktime(time.strptime(time.strftime("%Y-%m-%d"), "%Y-%m-%d"))
        con = sqlite3.connect(f"file:{FTL_DB}?mode=ro", uri=True, timeout=5)
        q, b, c = con.execute(f"SELECT COUNT(*), SUM(status IN {BLOCKED}), COUNT(DISTINCT client) FROM query_storage WHERE timestamp >= ?", (int(t0),)).fetchone()
        # Exclude SYSTEM_CLIENTS: preload and infrastructure traffic would skew device rates.
        # Response time matters: Pi-hole statuses 3/17 are cached; status 2 goes to unbound.
        # Under 5 ms counts as instant; over 50 ms indicates an upstream query.
        EXCL = "client NOT IN (SELECT id FROM client_by_id WHERE ip IN (%s))" % ",".join("'%s'" % c for c in SYSTEM_CLIENTS)
        answered, instant, internet, p50 = con.execute(f"""SELECT COUNT(*), SUM(reply_time < 0.005), SUM(reply_time > 0.05),
                (SELECT reply_time FROM query_storage WHERE timestamp >= ? AND status IN (2,3,17) AND {EXCL} ORDER BY reply_time LIMIT 1 OFFSET (SELECT COUNT(*)/2 FROM query_storage WHERE timestamp >= ? AND status IN (2,3,17) AND {EXCL}))
                FROM query_storage WHERE timestamp >= ? AND status IN (2,3,17) AND {EXCL}""", (int(t0), int(t0), int(t0))).fetchone()
        slow = internet or 0
        top = con.execute(f"SELECT d.domain, COUNT(*) n FROM query_storage q JOIN domain_by_id d ON d.id=q.domain WHERE q.timestamp >= ? AND q.status IN {BLOCKED} GROUP BY d.domain ORDER BY n DESC LIMIT 3", (int(t0),)).fetchall()
        con.close()
        g = sqlite3.connect(f"file:{GRAVITY_DB}?mode=ro", uri=True, timeout=5)
        gn = g.execute("SELECT COUNT(*) FROM gravity").fetchone()[0]
        gu = g.execute("SELECT value FROM info WHERE property='updated'").fetchone()
        g.close()
        return {"queries": q or 0, "blocked": b or 0, "clients": c or 0, "top_blocked": top, "gravity": gn, "gravity_updated": int(gu[0]) if gu else None,
                "cached": instant or 0, "answered": answered or 0, "p50_ms": (p50 or 0) * 1000, "slow": slow or 0}
    except Exception as e:
        return None

def timers():
    """systemd timers as (label, next-run epoch) pairs. Empty means unknown."""
    names = {"dnspreload-update": _('Update lists'), "dnspreload-slice": _('Slice preload (hourly)'), "dnspreload-full": _('Full preload (fallback)'), "dnspreload-network": _('Network preload'),
             "dnspreload-report": _('Weekly report'), "unbound-cache-dump": _('Save cache'), "dnspreload-metrics": _('Metrics')}
    out = sh("systemctl", "list-timers", "--no-pager", "-o", "json", "dnspreload*", "unbound-cache*")
    res = []
    try:
        for t in json.loads(out):
            u = t["unit"].replace(".timer", "")
            if u in names and t.get("next"): res.append((names[u], t["next"] / 1e6 if t["next"] > 1e12 else t["next"]))
    except Exception: pass
    return sorted(res, key=lambda x: x[1])

def failed_units():
    """Return stopped or failed services; None means systemd has no service data."""
    known = sh("systemctl", "list-units", "--all", "--no-legend", "--plain", "dnspreload-panel.service", "unbound.service", "pihole-FTL.service")
    if not known.strip(): return None
    bad = [l.split()[0] for l in sh("systemctl", "--failed", "--no-legend", "--plain", "dnspreload*", "unbound*", "pihole-FTL*").splitlines() if l.strip()]
    for u in ("unbound.service", "pihole-FTL.service", "dnspreload-update.timer", "dnspreload-slice.timer", "dnspreload-network.timer", "unbound-cache-dump.timer", "nftables.service"):
        st = sh("systemctl", "is-active", u).strip()
        if st != "active" and u not in bad: bad.append(f"{u} ({st or _('unknown')})")
    return bad

def list_counts():
    res = {}
    for p in sorted(LISTS.glob("*.txt")):
        n = sum(1 for l in p.open() if l.strip() and not l.startswith("#"))
        res[p.stem] = {"n": n, "mtime": p.stat().st_mtime}
    return res

def MODE_LABEL(lr):
    m = lr.get("mode")
    if m == "slice":
        return _('Slice {slot} of {slices}').format(slot=lr['slot'], slices=lr['slices']) if lr.get("slot") else _('one hourly slice')
    return _('all domains') if m == "full" else _('network domains only')

_cache = {"t": 0, "d": None}
def snapshot():
    if time.time() - _cache["t"] < 10 and _cache["d"]: return _cache["d"]
    s = ustats(); q = s.get("total.num.queries", 0); h = s.get("total.num.cachehits", 0)
    lr = json.loads((STATE / "last-run.json").read_text()) if (STATE / "last-run.json").exists() else {}
    hist = []
    if (STATE / "history.csv").exists():
        hist = [r.split(",") for r in (STATE / "history.csv").read_text().splitlines()[1:][-8:]]
    paused = 0
    if (STATE / "servfail-paused.json").exists():
        paused = sum(1 for v in json.loads((STATE / "servfail-paused.json").read_text()).values() if v > time.time())
    reports = sorted(STATE.glob("report-*.md"))
    dg = sh("dig", "+time=2", "+tries=1", "+noall", "+answer", "+stats", "@127.0.0.1", "heise.de", "A")
    dig_ok = " IN\tA\t" in dg or "\tA\t" in dg
    import re as _re; m = _re.search(r"Query time: (\d+)", dg); dig_ms = int(m.group(1)) if m else -1
    d = {"time": time.time(), "unbound_up": bool(s), "dig_ok": dig_ok, "dig_ms": dig_ms, "ftl_active": sh("systemctl", "is-active", "pihole-FTL").strip() == "active",
         "cache": int(s.get("msg.cache.count", 0)), "rrset": int(s.get("rrset.cache.count", 0)),
         "hit_rate": (h / q * 100) if q else None, "queries": int(q), "hits": int(h),
         "prefetch": int(s.get("total.num.prefetch", 0)), "expired": int(s.get("total.num.expired", 0)),
         "servfail": int(s.get("num.answer.rcode.SERVFAIL", 0)), "recursion_avg_ms": s.get("total.recursion.time.avg", 0) * 1000,
         "uptime_h": s.get("time.up", 0) / 3600, "last_run": lr, "history": hist, "lists": list_counts(), "paused": paused,
         "report": reports[-1].name if reports else None, "pihole": pihole_today(), "timers": timers(), "failed": failed_units()}
    _cache.update(t=time.time(), d=d); return d

def metrics():
    d = snapshot(); ts = int(time.time() * 1e9); ph = d["pihole"] or {}
    L = [f"dnspreload,host=pihole cache={d['cache']}i,rrset={d['rrset']}i,hit_rate={d['hit_rate'] or 0:.2f},queries={d['queries']}i,hits={d['hits']}i,prefetch={d['prefetch']}i,expired={d['expired']}i,servfail={d['servfail']}i,recursion_avg_ms={d['recursion_avg_ms']:.2f},paused={d['paused']}i,failed_units={len(d['failed'] or [])}i {ts}"]
    if ph: L.append(f"pihole_today,host=pihole queries={ph['queries']}i,blocked={ph['blocked']}i,clients={ph['clients']}i,gravity={ph['gravity']}i,cached={ph['cached']}i,answered={ph['answered']}i,p50_ms={ph['p50_ms']:.2f},slow={ph['slow']}i {ts}")
    for k, v in d["lists"].items(): L.append(f"dnspreload_list,host=pihole,list={k} n={v['n']}i,age_h={(time.time()-v['mtime'])/3600:.1f} {ts}")
    lr = d["last_run"]
    if lr: L.append(f"dnspreload_run,host=pihole,mode={lr.get('mode','?')} domains={lr.get('domains',0)}i,duration_s={lr.get('duration_s',0)},cache_before={int(float(lr.get('cache_before') or 0))}i,cache_after={int(float(lr.get('cache_after') or 0))}i {ts}")
    tmp = STATE / "metrics.txt.tmp"; tmp.write_text("\n".join(L) + "\n"); os.replace(tmp, STATE / "metrics.txt"); print("\n".join(L))

# ---------- Rendering ----------
def n(x):  # 48041 -> 48.041; accepts "20.1" and None.
    try: return f"{int(float(x)):,}".replace(",", ".")
    except (TypeError, ValueError): return _('no data')
def pct(x, digits=1):
    return _('no data') if x is None else f"{x:.{digits}f}".replace(".", ",") + " %"
def ago(ts):
    if not ts: return _('never')
    s = time.time() - ts
    if s < 90: return _('just now')
    if s < 5400: return _('{n} min ago').format(n=int(s/60))
    if s < 172800: return _('{n} h ago').format(n=int(s/3600))
    return _('{n} days ago ({date})').format(n=int(s/86400), date=time.strftime('%d.%m.%y', time.localtime(ts)))
def until(ts):
    s = ts - time.time(); clock = time.strftime("%H:%M", time.localtime(ts))
    if s < 0: return _('overdue')
    if s < 3600: return f"in {int(s/60)} min ({clock})"
    if s < 86400: return f"in {s/3600:.0f} h ({clock})"
    return dmy(ts)
def dmy(ts):  # epoch -> 25.09.26 21:18
    return time.strftime("%d.%m.%y %H:%M", time.localtime(ts))
def parse_ts(t):
    for f in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try: return time.mktime(time.strptime(t, f))
        except (ValueError, TypeError): pass
    return None
def dur(s):
    try: s = int(float(s or 0))
    except (TypeError, ValueError): return _('no data')
    return f"{s} s" if s < 90 else f"{s//60} min"

