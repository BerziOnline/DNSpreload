def reviewed_blocking():
    """Combine candidates with nightly reviews; display only reviewed 'keep' verdicts.
    Unreviewed candidates wait; dropped candidates stay hidden. Raw data remains at /api/v1/blocking/raw."""
    try: d = json.loads((STATE / "blockmon.json").read_text())
    except (OSError, ValueError): d = {}
    try: rv = json.loads((STATE / "blockmon-review.json").read_text()).get("reviews", {})
    except (OSError, ValueError): rv = None   # no reviewer installed: show the raw candidates
    out = {"time": d.get("time"), "reviewed_at": None, "over": [], "under": [], "pending": 0, "dropped": 0}
    if rv is None:
        for kind in ("over", "under"): out[kind] = [{**x, "review": None} for x in d.get(kind, [])]
        return out
    try: out["reviewed_at"] = (STATE / "blockmon-review.json").stat().st_mtime
    except OSError: pass
    for kind in ("over", "under"):
        for x in d.get(kind, []):
            r = rv.get(x["domain"])
            if not r or r.get("kind") != kind: out["pending"] += 1; continue
            if r.get("verdict") == "drop": out["dropped"] += 1; continue
            out[kind].append({**x, "review": {k: r.get(k) for k in ("purpose", "category", "if_blocked", "recommendation", "confidence", "reason", "device_note", "model", "revisions", "ts")}})
    return out

def device_label(dv):
    """Short device name from Pi-hole (host part only), else the IP."""
    nm = (dv.get("name") or "").strip()
    return nm.split(".")[0] if nm and not re.fullmatch(r"[0-9.:a-f]+", nm) else (dv.get("ip") or "?")


def device_list(devs):
    return ", ".join(f"{device_label(dv)} ({dv.get('queries', 0)}×)" for dv in devs)


def blocking_page():
    """Blocking-monitor suggestions with domain actions; no alerts or main-panel counter."""
    d = reviewed_blocking()
    dec = {}
    try: dec = json.loads((STATE / "blockmon-decisions.json").read_text())
    except (OSError, ValueError): pass
    def card(x):
        rv = x.get("review") or {}
        rec = {"allow": _('Recommendation: allow'), "deny": _('Recommendation: block'), "keep": _('Recommendation: keep as is')}.get(rv.get("recommendation"), "")
