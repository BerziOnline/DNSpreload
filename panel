def row(label, value, cls=None, sub=None, big=False):
    dot = f'<i class="dot {cls}"></i>' if cls else ""
    subh = f"<small>{html.escape(sub)}</small>" if sub else ""
    return f'<div class="row{" big" if big else ""}"><div class=l>{html.escape(label)}{subh}</div><div class=v>{html.escape(str(value))}{dot}</div></div>'
def section(title, cls, rows, nxt, act=False):
    return f'<section class="{cls}"><h2>{html.escape(title)}</h2>{"".join(rows)}<div class="next{" act" if act else ""}">{html.escape(nxt or "")}</div></section>'
def worst(*c):
    for k in ("r", "y", "u", "g"):
        if k in c: return k
    return "g"

def page(d):
    S = []; ph = d["pihole"]; lr = d["last_run"]; L = d["lists"]
    # 1 Status
    c_dns = "g" if d["unbound_up"] and d["ftl_active"] and d["dig_ok"] else "r"
    c_fail = "u" if d["failed"] is None else "r" if d["failed"] else "g"
    fresh = (time.time() - L["merged-final"]["mtime"] < 30 * 3600) if "merged-final" in L else None
    c_fresh = "u" if fresh is None else "g" if fresh else "y"
    rows = [row(_('DNS answers queries'), _('yes') if c_dns == "g" else _('NO'), c_dns, _('Test query through Pi-hole in {ms} ms').format(ms=d['dig_ms']) if c_dns == "g" else _('Test query through Pi-hole failed') if not d["dig_ok"] else _('unbound or Pi-hole stopped'), big=True),
            row(_('Failures'), _('unknown') if d["failed"] is None else _('none') if not d["failed"] else ", ".join(d["failed"]), c_fail, _('systemd services in this stack')),
            row(_('Preload list up to date'), _('yes') if fresh else _('unknown') if fresh is None else _('no'), c_fresh, _('As of {date}').format(date=dmy(L['merged-final']['mtime'])) if fresh is not None else _('List missing'))]
    st = worst(c_dns, c_fail, c_fresh)
    S.append(section("Status", st, rows, _('No action needed.') if st == "g" else _('Check journalctl -u <service> on the DNS server.'), st != "g"))
    # 2 Today: user view from Pi-hole.
    if ph:
        bp = (ph["blocked"] / ph["queries"] * 100) if ph["queries"] else 0
        rows = [row(_('Queries today'), n(ph["queries"]), None, _('from {n} devices').format(n=n(ph['clients'])), big=True),
                row(_('blocked queries'), f"{n(ph['blocked'])} · {pct(bp, 0)}", "g", _('Ads, trackers, malware'))]
        for dom, cnt in ph["top_blocked"]: rows.append(row(dom, n(cnt), None, _('most blocked domain') if dom == ph["top_blocked"][0][0] else None))
        gu = ph["gravity_updated"]; c_g = "r" if ph["gravity"] < 100000 else "g" if gu and time.time() - gu < 8 * 86400 else "y"
        rows.append(row(_('Blocklist'), _('{n} domains').format(n=n(ph['gravity'])), c_g, _('updated {ago}').format(ago=ago(gu))))
        S.append(section(_('Today'), worst(c_g), rows, _('No action needed.') if c_g == "g" else (_('Blocklist almost empty — run pihole -g.') if ph["gravity"] < 100000 else _('Blocklist older than 8 days — run pihole -g.')), c_g != "g"))
    else:
        S.append(section(_('Today'), "u", [row(_('Pi-hole data'), _('unreadable'), "u", _('No read access to pihole-FTL.db'))], _('Status incomplete — check the data source.'), True))
    # 3 Device response times, excluding preload, followed by unbound internals.
    rows = []; c_hr = "u"
    if ph and ph["answered"]:
        hr = ph["cached"] / ph["answered"] * 100; c_hr = "g" if hr >= 90 else "y" if hr >= 70 else "r"
        rows.append(row(_('Answered instantly'), pct(hr), c_hr, _('under 5 ms · {n} device queries today (excluding server, gateway, preload)').format(n=n(ph['answered'])), big=True))
        ir = ph["slow"] / ph["answered"] * 100
        rows.append(row(_('Queried upstream'), f"{pct(ir)} ({n(ph['slow'])})", "g" if ir < 3 else "y", _('over 50 ms · cache empty or expired')))
        rows.append(row(_('Typical response time'), f"{ph['p50_ms']:.0f} ms" if ph['p50_ms'] >= 1 else _('under 1 ms'), "g" if ph["p50_ms"] < 20 else "y", _("Today's median for devices")))
    elif ph: rows.append(row(_('No device queries yet today'), "–", "u"))
    else: rows.append(row(_('Device queries'), _('unreadable'), "u", _('Pi-hole data missing')))
    if d["unbound_up"]:
        rows += [row(_('Cache entries'), n(d["cache"]), "g" if d["cache"] > 20000 else "y", _('unbound, including preloaded entries')),
                 row(_('Refreshed in background'), n(d["prefetch"]), None, _('Prefetch before entries expire')),
                 row(_('Expired entries served instantly'), n(d["expired"]), None, _('then refreshed in background')),
                 row(_('Upstream queries'), f"{d['recursion_avg_ms']:.0f} ms", "g" if d["recursion_avg_ms"] < 300 else "y", _('Average for cache misses')),
                 row(_('unbound uptime'), f"{d['uptime_h']:.0f} h" if d["uptime_h"] >= 2 else f"{d['uptime_h']*60:.0f} min", "g", _('{n} queries including preload, SERVFAIL {fail}').format(n=n(d['queries']), fail=n(d['servfail'])))]
    else: rows.append(row("unbound", _('not responding'), "r", _('No readable statistics')))
    c3 = worst(c_hr if c_hr != "u" else "g", "y" if d["cache"] <= 20000 else "g", "r" if not d["unbound_up"] else "g")
    S.append(section(_('Response speed'), c3, rows, _('No action needed.') if c3 == "g" else _('Check unbound.') if not d["unbound_up"] else _('Small cache or low hit rate — the next full preload will refill it.'), c3 != "g"))
    # 4 Last preload
    if lr:
        comp = (lr.get("completed") or "").split("(")[-1].rstrip(")").replace("%", "").strip()
        try: cf = float(comp)
        except ValueError: cf = None
        c_c = "u" if cf is None else "g" if cf >= 98 else "y"
        t = lr.get("time", ""); tsr = parse_ts(t)
        c_w = "u" if tsr is None else "g" if time.time() - tsr < (3 * 3600 if lr.get("mode") == "slice" else 30 * 3600) else "y"
        rows = [row(_('When'), ago(tsr) if tsr else _('unknown'), c_w, dmy(tsr) if tsr else _('Unreadable time: {t}').format(t=t), big=True),
                row(_('What'), MODE_LABEL(lr), None, _('{n} domains in {duration}').format(n=n(lr.get('domains', 0)), duration=dur(lr.get('duration_s')))),
                row(_('Answered'), pct(cf), c_c, _('The rest are dead domains')),
                row(_('Cache after preload'), f"{n(lr.get('cache_before') or 0)} → {n(lr.get('cache_after') or 0)}", None, _('Entries before → after')),
                row(_('Paused after errors'), n(d["paused"]), "g" if d["paused"] < 500 else "y", _('Automatically retried after 7 days'))]
        S.append(section(_('Last preload'), worst(c_c, c_w), rows, _('No action needed.') if c_c == "g" else _('Under 98 % answered — check logs/ and last-run.json.'), c_c != "g"))
        hrows = []
        for r in reversed(d["history"][-6:]):
            if len(r) >= 9:
                hp = parse_ts(r[0]); hts = dmy(hp) if hp else r[0]
                hrows.append(row(hts, f"{n(r[2])} in {dur(r[4])}", None, MODE_LABEL({"mode": r[1]})))
        if hrows: S.append(section(_('History'), "g", hrows, _('Domains and duration per run; details in state/history.csv.')))
    else:
        S.append(section(_('Last preload'), "u", [row(_('No runs yet'), "–", "u")], _('First run: dnspreload preload slice (hourly timer).'), True))
    # 5 Next runs
    rows = [row(name, until(ts), "y" if ts < time.time() else None) for name, ts in d["timers"]]
    late = any(ts < time.time() for _, ts in d["timers"])
    S.append(section(_('Next runs'), "u" if not rows else "y" if late else "g", rows or [row("Timer", _('unreadable'), "u")], _('Automatic systemd timers.') if rows and not late else _('A timer is overdue — check systemctl list-timers.') if late else _('Check systemctl list-timers.'), not rows or late))
    # 6 Lists
    rows = []
    for k, (label, sub) in LIST_NAMES.items():
        if k in L:
            cnt = L[k]["n"]; age = time.time() - L[k]["mtime"]
            cls = None if k in ("static-manual", "exclude", "network-blocked-excluded") else "g" if age < 30 * 3600 else "y"
            rows.append(row(label, n(cnt), cls, sub, big=(k == "merged-final")))
    c6 = "y" if any("y" in (r or "") for r in rows) else "g"
    S.append(section(_('Lists'), c6, rows, _('Rebuilt daily at 03:50.') if c6 == "g" else _('A list is older than 30 h — check the list update.'), c6 != "g"))
    # Timed Pi-hole group switches: dnspreload-switch list returns configuration and state.
    for sw in switches():
        on, end_s, name = sw["on"], sw.get("until") or 0, sw["name"]
        partial = sw.get("kind") == "partial"
        val = _('off · {n} min left').format(n=max(0, int((end_s - time.time()) // 60))) if on else _('on')
        r0 = row(_('State'), val, "y" if on else "g", _('back on at {clock}').format(clock=time.strftime('%H:%M', time.localtime(end_s))) if on else sw["scope"], big=True)
        if on: r0 = r0.replace("<div class=v>", f"<div class=v id=rest-{name} data-end={int(end_s)}>", 1)
        btns = f"<button name=a value=off>{_('turn back on')}</button>" if on else "".join(f"<button name=a value=on{m}>{_('off for {m} min').format(m=m)}</button>" if m < 60 else f"<button name=a value=on{m}>{_('off for {n} h').format(n=m//60)}</button>" for m in sw["presets"])
        rows = [r0, f"<div class=row><form method=post action=/switch/{name} style='display:flex;gap:8px;width:100%'>{btns}</form></div>"]
        if on: rows.append(f"<script>(function(){{var e=document.getElementById('rest-{name}');if(!e)return;var t=+e.dataset.end,d=e.querySelector('i');function f(){{var s=t-Date.now()/1000;if(s<=0){{location.reload();return}}e.textContent='{_('off · ')}'+Math.floor(s/60)+':'+('0'+Math.floor(s%60)).slice(-2)+' min';if(d)e.appendChild(d)}}f();setInterval(f,1000)}})()</script>")
        S.append(section(("◐ " if partial else "● ") + sw["label"], "y" if on else "g", rows, (_('Partial: Google Ads domains only') if partial else _('Full: all blocklists')) + (_(' — turns back on automatically.') if on else "."), on))
    S.append(section(_('Blocking suggestions'), "g", [f"<div class=row><a href=/blocking style='display:block;width:100%;text-align:center;padding:12px;border:1px solid #30363d;border-radius:8px;color:#e6edf3;text-decoration:none'>{_('View suggestions')}</a></div>"], _('When you have time: domains that may be overblocked or underblocked.')))
    body = "".join(S)
    return (f"<!doctype html><html lang={UI_LANG}><head><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'>"
            f"<title>DNSpreload</title><style>{CSS}</style></head><body><header><h1><img src=/logo.svg alt='' style='height:26px;vertical-align:-6px;margin-right:8px'>{html.escape(PANEL_TITLE)}</h1><span>{dmy(d['time'])}</span></header>"
            f"<main>{body}</main><footer>{_('Admin and server VLAN')} · <a href='/json'>{_('Raw data')}</a> · <a href='/metrics'>{_('Metrics')}</a>"
            f"{' · <a href=/report>' + _('Weekly report') + '</a>' if d['report'] else ''}</footer></body></html>")

def switches():
    try: return json.loads(sh("sudo", "-n", "/usr/local/bin/dnspreload-switch", "list") or "[]")
    except ValueError: return []
def switch_set(name, action, minutes=None):
    if not re.fullmatch(r"[a-z][a-z0-9-]{1,30}", name): return False
    args = ["off"] if action == "off" else ["on", str(int(minutes))] if action == "on" and minutes else None
    if not args: return False
    try: return subprocess.run(["sudo", "-n", "/usr/local/bin/dnspreload-switch", name, *args], capture_output=True, timeout=15).returncode == 0
    except Exception: return False
TOKEN_SEEN = STATE / "token-seen.json"       # id -> last access epoch, separate from token configuration.
_seen_cache = {"t": 0, "d": {}}
def touch_token(tid):
    now = time.time()
    if now - _seen_cache["d"].get(tid, 0) < 60: return          # Write at most once per minute.
    try: d = json.loads(TOKEN_SEEN.read_text()) if TOKEN_SEEN.exists() else {}
    except (OSError, ValueError): d = {}
    d[tid] = int(now); _seen_cache["d"] = d
    try: tmp = TOKEN_SEEN.with_suffix(".tmp"); tmp.write_text(json.dumps(d)); os.replace(tmp, TOKEN_SEEN)
    except OSError: pass
def role_of(token):
    """Resolve a token to (role, label) or None and record its last access."""
    if not token or not TOKENS.exists(): return None
    h = hashlib.sha256(token.encode()).hexdigest()
    try:
        for k, v in json.load(TOKENS.open()).items():
            if v.get("hash") == h: touch_token(k); return v["role"], v["label"]
    except (ValueError, OSError): pass
    return None
def token_list():
    try: d = json.load(TOKENS.open())
    except (ValueError, OSError): d = {}
    try: seen = json.loads(TOKEN_SEEN.read_text()) if TOKEN_SEEN.exists() else {}
    except (OSError, ValueError): seen = {}
    return [{"id": k, "role": v["role"], "label": v["label"], "token": v.get("token"), "created": v.get("created"), "last_seen": seen.get(k)} for k, v in d.items()]
def token_add(role, label):
    if role not in ("admin", "family") or not re.fullmatch(r"[\w .:@/()+-]{1,40}", label): return None
    try: out = sh("sudo", "-n", "/usr/local/bin/dnspreload-token", "add", role, label)
    except Exception: return None
    m = re.search(r"TOKEN \(einmalig\): (\S+)", out or ""); return m.group(1) if m else None
def token_revoke(tid):
    if not re.fullmatch(r"\d{1,6}", tid): return False
    try: return "entfernt" in (sh("sudo", "-n", "/usr/local/bin/dnspreload-token", "revoke", tid) or "")
    except Exception: return False

