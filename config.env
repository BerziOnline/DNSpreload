# DNSpreload v2 - all settings. Changes apply on the next run; only PANEL_* and UI_LANG need
# `systemctl restart dnspreload-panel`.

# --- What to preload ---------------------------------------------------------
LEARN_DAYS=90            # learn every domain your network resolved (allowed) in this window
RECENT_HOURS=24          # "network-recent": only the last N hours (afternoon run)
FREQUENT_DAYS=30         # "network-frequent": window for counting ...
FREQUENT_MIN_PER_DAY=3   # ... domains asked at least this often per day on average

TOP_DE=0                 # .de domains from the top list: 0 = all of them (~9,400)
TOP_INTL=20000           # international domains (non-.de) from the top list - target count AFTER the TLD filter
# TLD filter for the international list: filter first, then cut to TOP_INTL. Too few matches -> all are taken.
INTL_TLD_WHITELIST=true  # true = keep only the TLDs below, false = drop the TLDs below
INTL_TLDS=com,net,org,info,io,co,me,tv,app,dev,ai,cloud,tech,eu,at,ch,li,lu,uk,us,ca,au,nz,ie,edu,gov,online,site,shop,store,blog,news,page,live,xyz,gg,to,fm,ly,so,google,microsoft,amazon,apple,youtube   # empty = no filter
SOURCES=tranco,umbrella  # top-list sources in order of preference; the first one reachable wins
RADAR_TOKEN=             # optional Cloudflare API token (Radar: Read) - adds Cloudflare's top-100 for Germany; never commit it
RADAR_BUCKET=100000      # Cloudflare ranking bucket used to confirm Tranco entries (50000/100000/200000/500000/1000000)

# --- How fast ------------------------------------------------------------------
SLICE_HOURS=22           # hourly slice: the list is split into 22 parts, every name is refreshed every 22 h (< serve-expired-ttl 24 h)
SLICE_QPS=5              # queries per second for the hourly slice (~3,300 names per slice = ~11 min, invisible to the uplink)
QPS=25                   # queries per second for manual full runs (dnspreload-full) and the network runs
DNSPERF_TIMEOUT=8        # seconds until a single query counts as lost
SERVFAIL_PAUSE_DAYS=7    # domains that return SERVFAIL are skipped for this many days

# --- Web panel & app -------------------------------------------------------------
UI_LANG=en               # panel and blocking monitor texts: en | de
PANEL_BIND=127.0.0.1     # address the panel listens on - set your DNS server's LAN address to reach it from other devices
PANEL_PORT=8053
PANEL_TITLE=DNS · Pi-hole   # panel header
ADMIN_NETS=127.0.0.      # comma-separated IP prefixes that get the admin view without a token, e.g. 192.168.1.  (also restrict with systemd/dnspreload-panel.nft)
SYSTEM_CLIENTS=127.0.0.1 # comma-separated IPs left out of statistics and the blocking monitor (preload itself, servers, the router)
STATS_SINCE=0            # Unix time: statistics start here (e.g. after importing old Pi-hole history); 0 = all

# --- Resolver --------------------------------------------------------------------
UNBOUND=127.0.0.1
UNBOUND_PORT=5335        # query unbound directly, NOT Pi-hole (otherwise every preload lands in the query log)
EXCLUDE_TLDS=arpa,lan,local,localhost,home,internal,onion

FTL_DB=/etc/pihole/pihole-FTL.db
GRAVITY_DB=/etc/pihole/gravity.db
